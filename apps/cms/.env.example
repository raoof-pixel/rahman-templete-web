# ======================================================================
# CanadianSME CMS (apps/cms) — copy to apps/cms/.env for local development
# ======================================================================

# --- Database: Supabase Postgres (required) ---
# Supabase dashboard > Project > Connect > "Session pooler". Use a separate staging project locally.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ca-central-1.pooler.supabase.com:5432/postgres?sslmode=require
# Connections per server instance. Keep small on Amplify (each compute instance has its own pool).
DATABASE_POOL_MAX=5
# Optional: Supabase's CA certificate (Database settings > SSL) to fully verify the server.
# Paste with \n for line breaks.
DATABASE_CA_CERT=

# Long random string, e.g. output of: openssl rand -hex 32  (signs every login)
PAYLOAD_SECRET=change-me

# Where this CMS runs (admin + API)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Where the public website runs (used for SEO URLs and CORS)
NEXT_PUBLIC_SITE_URL=https://canadiansme.ca

# --- Files: Supabase Storage (leave S3_BUCKET empty locally to store files in apps/cms/public/media) ---
# Supabase dashboard > Storage > S3 Connection. The bucket must be public.
SUPABASE_URL=https://<project-ref>.supabase.co
S3_BUCKET=media
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=ca-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Scheduled publishing (AWS EventBridge Scheduler sends "Authorization: Bearer <this>") ---
# At least 32 random characters.
CRON_SECRET=

# --- Connecting the website (apps/web) ---
# Extra origins allowed to call the API from a browser, comma-separated
CORS_ORIGINS=http://localhost:3001
# The website that shows this content ("View on website" and draft previews)
WEBSITE_URL=http://localhost:3001
# Called after content is published/changed/unpublished so the website refreshes just those pages.
# AWS Amplify has no on-demand revalidation: leave empty there (pages refresh on their timer).
FRONTEND_REVALIDATE_URL=http://localhost:3001/api/revalidate/
# Same value as REVALIDATE_SECRET in apps/web
REVALIDATE_SECRET=change-me-too

# --- WordPress import (READ-ONLY: the importer only reads from WordPress) ---
WP_BASE_URL=https://canadiansme.ca
# Optional: an Application Password lets the importer also read drafts.
WP_USERNAME=
WP_APP_PASSWORD=

# --- Website forms (POST /api/forms/:type, called only by the website server) ---
# At least 32 random characters. Same value as FORMS_SECRET in apps/web.
FORMS_SECRET=
# Optional: newsletter sign-ups go to this Mailchimp audience as "pending" (double opt-in).
# Key looks like abc123...-us21; audience ID from Audience > Settings.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# --- Downloads from content URLs (importer, seed) ---
# Extra hosts the CMS may download images from, comma-separated (canadiansme.ca, i0.wp.com etc. are built in).
DOWNLOAD_ALLOWED_HOSTS=

# --- Security ---
# Let Automation (API-key) users publish directly. Default: they can only save drafts for review.
AUTOMATION_CAN_PUBLISH=false
