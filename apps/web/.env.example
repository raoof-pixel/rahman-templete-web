# ======================================================================
# canadiansme.ca website (apps/web) — copy to apps/web/.env for local development
# ======================================================================

# The CMS (apps/cms). Locally http://localhost:3000, in production https://cms.canadiansme.ca
CMS_URL=http://localhost:3000

# This website's public address (canonical URLs, sitemap, RSS, form origin check)
SITE_URL=http://localhost:3001

# Supabase project URL (lets the browser load images and audio from Supabase Storage)
SUPABASE_URL=https://<project-ref>.supabase.co

# Shared secret for form submissions: same value as FORMS_SECRET in apps/cms, 32+ random characters
# (openssl rand -hex 32). Forms are refused if it is missing or short.
FORMS_SECRET=change-me
# Extra origins allowed to post forms (comma-separated), e.g. the Amplify preview URL
FORMS_ALLOWED_ORIGINS=

# Shared secret the CMS sends after a publish (same as REVALIDATE_SECRET in apps/cms).
# Only takes effect where on-demand revalidation is supported (not on Amplify Hosting).
REVALIDATE_SECRET=change-me-too

# Old article HTML still points at https://canadiansme.ca/wp-content/uploads/...
# Those links are rewritten to Supabase in the final WordPress-import phase, before the domain switch.

# true on staging: adds noindex to every page and blocks robots
SITE_NOINDEX=false
